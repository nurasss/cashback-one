APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/poscenter_loyalty
REDIS_URL=redis://localhost:6379/0

# TASK-003 Auth Secrets (min 32 chars each)
JWT_SIGNING_KEY=change_me_to_a_secure_random_key_at_least_32_chars_long
AUTH_CHALLENGE_HASH_KEY=change_me_to_a_secure_random_key_at_least_32_chars_long
WHATSAPP_LOGIN_NUMBER=+77001234567

# TASK-004 Wappi Webhook Configuration
WAPPI_LOGIN_PROFILE_ID=wappi_login_profile_uuid_or_id
# Set to the actual header name verified from the active Wappi webhook profile
# Public documentation status: WAPPI_AUTH_HEADER_NAME = NOT VERIFIED
WAPPI_WEBHOOK_AUTH_HEADER=<verified_wappi_header_name>
WAPPI_WEBHOOK_AUTH_SECRET=change_me_to_a_secure_wappi_webhook_secret_at_least_32_chars_long

WAPPI_WEBHOOK_MAX_BODY_BYTES=65536

# TASK-007 SMS OTP Fallback Configuration (min 32 chars)
SMS_OTP_HASH_KEY=change_me_to_a_secure_sms_otp_hash_key_at_least_32_chars_long
SMS_PROVIDER_MODE=disabled


# TASK-011A Admin security (separate signing key; never reuse JWT_SIGNING_KEY)
ADMIN_JWT_SIGNING_KEY=
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_SECONDS=28800
# Exact origin list as JSON. Replace with HTTPS Admin SPA origin in production.
ADMIN_ALLOWED_ORIGINS=["https://admin.example.invalid"]
ADMIN_LOGIN_LIMIT=5
ADMIN_LOGIN_IP_LIMIT=20
ADMIN_LOGIN_RATE_WINDOW_SECONDS=300
ADMIN_AGENT_STALE_SECONDS=900
ADMIN_MAX_STATS_PERIOD_DAYS=90
# HTTP is development only; also requires an explicit local/LAN origin allowlist entry.
ADMIN_ALLOW_INSECURE_HTTP=0

# Outbound WhatsApp (login code, POS write-off code) via Wappi send API.
# disabled | wappi | log (development only: prints codes to the server log). fake is for tests only.
WHATSAPP_PROVIDER_MODE=disabled
WAPPI_API_BASE_URL=https://wappi.pro
WAPPI_API_TOKEN=
# Defaults to WAPPI_LOGIN_PROFILE_ID when empty
WAPPI_SENDER_PROFILE_ID=
