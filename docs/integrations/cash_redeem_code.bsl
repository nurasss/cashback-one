// Cashback One — подтверждение списания баллов кодом из приложения покупателя.
// Для 1С 8; для Cash (1С 7.7) — cash77_code_push.txt и раздел /pos/code-push.
// Для разработчиков POSCENTER Cash. Касса обращается НАПРЯМУЮ в облако Cashback One,
// агент на компьютере оператора для этого не нужен.
//
// СТАТУС: контракт утверждён 2026-11-04, серверная часть в разработке (задача B).
// Код не запускался на платформе 1С. До готовности сервера адреса отвечают 404.
//
// Схема:
//   1. Кассир сканирует QR из приложения (в нём номер карты, как на пластиковой карте)
//      и указывает сумму списания баллов.
//   2. ЗапроситьКодСписания() — облако отправляет покупателю push-уведомление с кодом
//      из 4 цифр. Код действует 5 минут.
//   3. ПоказатьОкноКода() — кассир вводит код со слов покупателя, облако проверяет код.
//      Неверный код можно ввести снова, после 5 неверных попыток нужен новый код.
//   4. Только при успешной проверке Cash проводит списание штатно. Облако баллы не списывает:
//      списание попадает в ONE из Cash, как сейчас.
//   Нет приложения у покупателя -> ошибка CUSTOMER_NO_APP, списание не проводить,
//   предложить покупателю установить приложение.
//
// Настройки кассы (хранить в защищённой настройке Cash, НЕ в коде и НЕ в логах):
//   АдресОблака = "api.cashback-qr.poscenter.kz" (только хост, без https:// и пути)
//   КлючКассы   = ключ кассы, выдаётся в кабинете Cashback One (показывается один раз)

Функция НовыйРезультат()
    Возврат Новый Структура("Успех,КодОшибки,Сообщение,ИдЗапроса,Штрихкод,Сумма",
        Ложь, "", "", "", "", 0);
КонецФункции

// POST в облако. Возвращает Структура("Код,Данные"); Данные = Структура или Неопределено.
Функция ВызватьОблако(Путь, Тело, АдресОблака, КлючКассы)
    Ответ = Новый Структура("Код,Данные", 0, Неопределено);
    // Таймаут 15 секунд, только HTTPS.
    Соединение = Новый HTTPСоединение(АдресОблака, 443, , , , 15,
        Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-Pos-Key", КлючКассы);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Тело);
    Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8,
        ИспользованиеByteOrderMark.НеИспользовать);
    HTTPОтвет = Соединение.ВызватьHTTPМетод("POST", Запрос);
    Ответ.Код = HTTPОтвет.КодСостояния;
    ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
    Если ЗначениеЗаполнено(ТекстОтвета) Тогда
        Попытка
            Чтение = Новый ЧтениеJSON;
            Чтение.УстановитьСтроку(ТекстОтвета);
            Ответ.Данные = ПрочитатьJSON(Чтение);
            Чтение.Закрыть();
        Исключение
            Ответ.Данные = Неопределено;
        КонецПопытки;
    КонецЕсли;
    Возврат Ответ;
КонецФункции

Функция КодОшибкиОтвета(Данные)
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        Возврат "";
    КонецЕсли;
    Ошибка = Неопределено;
    Если Не Данные.Свойство("error", Ошибка) Или ТипЗнч(Ошибка) <> Тип("Структура") Тогда
        Возврат "";
    КонецЕсли;
    Код = "";
    Если Не Ошибка.Свойство("code", Код) Или ТипЗнч(Код) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;
    Возврат Код;
КонецФункции

// Тексты для кассира. Текст ответа сервера кассиру не показывать.
Функция ТекстОшибки(Код)
    Если Код = "CUSTOMER_NO_APP" Тогда
        Возврат "У покупателя нет приложения Cashback One или выключены уведомления. "
            + "Списание баллов невозможно. Предложите установить приложение.";
    ИначеЕсли Код = "INVALID_CODE" Тогда
        Возврат "Неверный код. Попросите покупателя проверить уведомление.";
    ИначеЕсли Код = "REDEMPTION_EXPIRED" Тогда
        Возврат "Срок действия кода истёк. Запросите новый код.";
    ИначеЕсли Код = "REDEMPTION_MAX_ATTEMPTS_EXCEEDED" Тогда
        Возврат "Слишком много неверных попыток. Запросите новый код.";
    ИначеЕсли Код = "REDEMPTION_NOT_ACTIVE" Или Код = "REDEMPTION_ALREADY_CONFIRMED" Тогда
        Возврат "Этот код уже недействителен. Запросите новый код.";
    ИначеЕсли Код = "CARD_NOT_FOUND" Тогда
        Возврат "Карта не найдена в программе лояльности.";
    ИначеЕсли Код = "CARD_BLOCKED" Тогда
        Возврат "Карта заблокирована.";
    ИначеЕсли Код = "RATE_LIMIT_EXCEEDED" Тогда
        Возврат "Слишком много запросов кода. Подождите несколько минут.";
    ИначеЕсли Код = "REDEMPTION_NOT_FOUND" Тогда
        Возврат "Запрос кода не найден. Запросите новый код.";
    ИначеЕсли Код = "PUSH_NOT_CONFIGURED" Тогда
        Возврат "Отправка уведомлений Cashback One не настроена. Обратитесь к администратору.";
    ИначеЕсли Код = "PUSH_DELIVERY_FAILED" Тогда
        Возврат "Не удалось отправить код покупателю. Попробуйте ещё раз.";
    ИначеЕсли Код = "POS_KEY_MISSING" Или Код = "POS_KEY_INVALID" Или Код = "POS_KEY_REVOKED" Тогда
        Возврат "Касса не подключена к Cashback One. Обратитесь к администратору.";
    ИначеЕсли Код = "VALIDATION_ERROR" Тогда
        Возврат "Ошибка данных запроса. Обратитесь к разработчикам Cash.";
    КонецЕсли;
    Возврат "Ошибка сервиса Cashback One. Попробуйте позже.";
КонецФункции

// Шаг 1. Запросить код. Штрихкод — строка из 4–13 цифр, ведущие нули сохранять.
// Сумма — число баллов к списанию, больше нуля.
Функция ЗапроситьКодСписания(Штрихкод, Сумма, АдресОблака, КлючКассы) Экспорт
    Итог = НовыйРезультат();
    // Сумму передаём строкой, чтобы не потерять точность.
    СуммаСтрокой = Формат(Сумма, "ЧРД=.; ЧГ=0; ЧН=0");
    Попытка
        Ответ = ВызватьОблако("/pos/redemptions",
            Новый Структура("barcode,amount", Строка(Штрихкод), СуммаСтрокой),
            АдресОблака, КлючКассы);
    Исключение
        // ОписаниеОшибки() не показывать и не логировать: может содержать ключ.
        Итог.КодОшибки = "CONNECTION_ERROR";
        Итог.Сообщение = "Нет связи с Cashback One. Проверьте интернет.";
        Возврат Итог;
    КонецПопытки;

    ИдЗапроса = Неопределено;
    Если Ответ.Код = 201 И ТипЗнч(Ответ.Данные) = Тип("Структура")
        И Ответ.Данные.Свойство("redemption_id", ИдЗапроса) Тогда
        Итог.Успех = Истина;
        Итог.ИдЗапроса = ИдЗапроса;
        Итог.Сообщение = "Код отправлен в приложение покупателя.";
        Возврат Итог;
    КонецЕсли;

    Итог.КодОшибки = КодОшибкиОтвета(Ответ.Данные);
    Итог.Сообщение = ТекстОшибки(Итог.КодОшибки);
    Возврат Итог;
КонецФункции

// Шаг 2. Проверить код, введённый кассиром.
Функция ПроверитьКодСписания(ИдЗапроса, Код, АдресОблака, КлючКассы) Экспорт
    Итог = НовыйРезультат();
    Итог.ИдЗапроса = ИдЗапроса;
    КодЧистый = СокрЛП(Код);
    Если СтрДлина(КодЧистый) <> 4 Или Не СтрокаТолькоИзЦифр(КодЧистый) Тогда
        Итог.КодОшибки = "INVALID_CODE";
        Итог.Сообщение = "Код состоит из 4 цифр.";
        Возврат Итог;
    КонецЕсли;
    Попытка
        Ответ = ВызватьОблако("/pos/redemptions/" + ИдЗапроса + "/verify",
            Новый Структура("code", КодЧистый), АдресОблака, КлючКассы);
    Исключение
        Итог.КодОшибки = "CONNECTION_ERROR";
        Итог.Сообщение = "Нет связи с Cashback One. Проверьте интернет.";
        Возврат Итог;
    КонецПопытки;

    Если Ответ.Код = 200 И ТипЗнч(Ответ.Данные) = Тип("Структура") Тогда
        Статус = "";
        Штрихкод = "";
        Сумма = "";
        Если Ответ.Данные.Свойство("status", Статус) И Статус = "confirmed"
            И Ответ.Данные.Свойство("barcode", Штрихкод)
            И Ответ.Данные.Свойство("amount", Сумма) Тогда
            Итог.Успех = Истина;
            // НЕ преобразовывать штрихкод в число: ведущие нули должны сохраниться.
            Итог.Штрихкод = Штрихкод;
            Итог.Сумма = Число(Сумма);
            Возврат Итог;
        КонецЕсли;
    КонецЕсли;

    Итог.КодОшибки = КодОшибкиОтвета(Ответ.Данные);
    Итог.Сообщение = ТекстОшибки(Итог.КодОшибки);
    Возврат Итог;
КонецФункции

Функция СтрокаТолькоИзЦифр(Значение)
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

// Шаг 3. Окно ввода кода (управляемая форма, асинхронно).
// Контекст — Структура("ИдЗапроса,Штрихкод,Сумма,АдресОблака,КлючКассы,ОповещениеИтог").
// ОповещениеИтог получает Истина (можно проводить списание) или Ложь (не проводить).
Процедура ПоказатьОкноКода(Контекст) Экспорт
    ПоказатьВводСтроки(Новый ОписаниеОповещения("ПослеВводаКода", ЭтотОбъект, Контекст),
        "", "Код из приложения покупателя (4 цифры)", 4, Ложь);
КонецПроцедуры

Процедура ПослеВводаКода(Строка, Контекст) Экспорт
    Если Строка = Неопределено Тогда
        ВыполнитьОбработкуОповещения(Контекст.ОповещениеИтог, Ложь); // кассир отменил
        Возврат;
    КонецЕсли;

    Итог = ПроверитьКодСписания(Контекст.ИдЗапроса, Строка, Контекст.АдресОблака,
        Контекст.КлючКассы);
    Если Итог.Успех Тогда
        // Сверить: сервер подтвердил ту же карту и ту же сумму, что на кассе.
        Если Итог.Штрихкод <> Строка(Контекст.Штрихкод) Или Итог.Сумма <> Контекст.Сумма Тогда
            ПоказатьПредупреждение(, "Подтверждение не совпадает с чеком. Списание не проведено.");
            ВыполнитьОбработкуОповещения(Контекст.ОповещениеИтог, Ложь);
            Возврат;
        КонецЕсли;
        ВыполнитьОбработкуОповещения(Контекст.ОповещениеИтог, Истина);
        Возврат;
    КонецЕсли;

    Если Итог.КодОшибки = "INVALID_CODE" Тогда
        // Неверный код: дать ввести снова. Лимит попыток считает сервер.
        ПоказатьПредупреждение(Новый ОписаниеОповещения("ПовторитьВводКода", ЭтотОбъект, Контекст),
            Итог.Сообщение);
    Иначе
        ПоказатьПредупреждение(, Итог.Сообщение);
        ВыполнитьОбработкуОповещения(Контекст.ОповещениеИтог, Ложь);
    КонецЕсли;
КонецПроцедуры

Процедура ПовторитьВводКода(Контекст) Экспорт
    ПоказатьОкноКода(Контекст);
КонецПроцедуры

