// Пример, проверить у разработчиков Cash.
// Не запускался на платформе 1С. Не создаёт документы и не изменяет ONE.
// ПарольКассы получать из защищённой настройки Cash, НЕ записывать в код или лог.
// АдресАгента — только адрес хоста (без http:// и пути), Порт — число.

Функция ЭтоДинамическийQR(Значение) Экспорт
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Длина = СтрДлина(Значение);
    Если Длина < 22 Или Длина > 122 Или Лев(Значение, 2) <> "C1" Тогда
        Возврат Ложь;
    КонецЕсли;
    // Эквивалент ^C1[A-Z2-7]{20,120}$ без зависимости от API регулярных выражений.
    Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
    Для Индекс = 3 По Длина Цикл
        Если СтрНайти(Алфавит, Сред(Значение, Индекс, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция ЭтоШтрихкодКартыPOS(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СтрДлина(Значение) < 4 Или СтрДлина(Значение) > 13 Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция ПолучитьШтрихкодКартыПоQR(Токен, АдресАгента, Порт, ПарольКассы) Экспорт
    Результат = Новый Структура("Успех,Штрихкод,КодОшибки,Сообщение", Ложь, "", "", "");
    Если Не ЭтоДинамическийQR(Токен) Тогда
        Результат.КодОшибки = "QR_TOKEN_MALFORMED";
        Результат.Сообщение = "Некорректный QR. Попросите покупателя обновить QR.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        // Тайм-аут 7 секунд. Общий предел ожидания UI также реализовать в Cash.
        // Проверить семантику тайм-аута на используемой версии платформы.
        Соединение = Новый HTTPСоединение(АдресАгента, Порт, , , , 7);
        Запрос = Новый HTTPЗапрос("/v1/qr/resolve");
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.Заголовки.Вставить("X-Pos-Token", ПарольКассы);
        Запись = Новый ЗаписьJSON;
        Запись.УстановитьСтроку();
        ЗаписатьJSON(Запись, Новый Структура("token", Токен));
        Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8,
            ИспользованиеByteOrderMark.НеИспользовать);
        // Платформа должна выставить Content-Length по UTF-8 телу; проверить в Cash.
        // Ключ X-Agent-Key здесь НЕ используется. Автоматических повторов нет.
        Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
    Исключение
        Результат.КодОшибки = "POS_CONNECTION_ERROR";
        Результат.Сообщение = "Нет связи с агентом. Проверьте адрес, сеть и Firewall.";
        // ОписаниеОшибки() может содержать секреты: не выводить и не логировать.
        Возврат Результат;
    КонецПопытки;

    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Если ТипЗнч(Данные) <> Тип("Структура") Тогда
            ВызватьИсключение "Некорректная структура ответа";
        КонецЕсли;
        Если Ответ.КодСостояния = 200 Тогда
            Штрихкод = Неопределено;
            Если Не Данные.Свойство("barcode", Штрихкод) Тогда
                ВызватьИсключение "Не получен штрихкод";
            КонецЕсли;
            Если Не ЭтоШтрихкодКартыPOS(Штрихкод) Тогда
                ВызватьИсключение "Некорректный штрихкод";
            КонецЕсли;
            Результат.Успех = Истина;
            // НЕ преобразовывать в число: ведущие нули должны сохраниться.
            Результат.Штрихкод = Штрихкод;
            Возврат Результат;
        КонецЕсли;
        ОшибкаСервиса = Неопределено;
        Код = "";
        Если Не Данные.Свойство("error", ОшибкаСервиса) Тогда
            ВызватьИсключение "Не получен код ошибки";
        КонецЕсли;
        Если ТипЗнч(ОшибкаСервиса) <> Тип("Структура") Тогда
            ВызватьИсключение "Некорректная ошибка";
        КонецЕсли;
        Если Не ОшибкаСервиса.Свойство("code", Код) Тогда
            ВызватьИсключение "Не получен код ошибки";
        КонецЕсли;
        Если ТипЗнч(Код) <> Тип("Строка") Тогда
            ВызватьИсключение "Некорректный код";
        КонецЕсли;
    Исключение
        Результат.КодОшибки = "POS_BAD_RESPONSE";
        Результат.Сообщение = "Некорректный ответ агента. Обратитесь к администратору.";
        Возврат Результат;
    КонецПопытки;

    // Сообщения локальные: не отражать произвольный текст ответа/исключения кассиру.
    Результат.КодОшибки = Код;
    Если Код = "QR_TOKEN_INVALID" Или Код = "QR_TOKEN_MALFORMED" Тогда
        Результат.Сообщение = "Попросите покупателя обновить QR и отсканируйте заново.";
    ИначеЕсли Код = "POS_UNAUTHORIZED" Тогда
        Результат.Сообщение = "Неверный пароль кассы. Обратитесь к администратору.";
    ИначеЕсли Код = "POS_FORBIDDEN" Тогда
        Результат.Сообщение = "IP кассы не разрешён. Обратитесь к администратору.";
    ИначеЕсли Код = "POS_RATE_LIMITED" Тогда
        Результат.Сообщение = "Слишком много запросов. Подождите минуту.";
    ИначеЕсли Код = "AGENT_NOT_AUTHORIZED" Тогда
        Результат.Сообщение = "Ключ агента не принят облаком. Обратитесь к администратору.";
    ИначеЕсли Код = "CLOUD_TIMEOUT" Или Код = "CLOUD_UNAVAILABLE" Тогда
        Результат.Сообщение = "Облако недоступно или не ответило вовремя. Проверьте интернет.";
    ИначеЕсли Код = "CLOUD_ERROR" Тогда
        Результат.Сообщение = "Ошибка ответа облака. Обратитесь к администратору.";
    ИначеЕсли Код = "POS_REQUEST_TIMEOUT" Тогда
        Результат.Сообщение = "Истекло время передачи запроса. Проверьте локальную сеть.";
    ИначеЕсли Код = "POS_BODY_TOO_LARGE" Тогда
        Результат.Сообщение = "Сканирование содержит слишком много данных.";
    ИначеЕсли Код = "POS_BAD_REQUEST" Или Код = "POS_LENGTH_REQUIRED"
        Или Код = "POS_UNSUPPORTED_MEDIA_TYPE" Или Код = "POS_NOT_FOUND" Тогда
        Результат.Сообщение = "Ошибка интеграции кассы. Обратитесь к разработчикам Cash.";
    Иначе
        // Не выводить непредусмотренный code: ответ может прийти не от агента.
        Результат.КодОшибки = "POS_INTERNAL_ERROR";
        Результат.Сообщение = "Ошибка агента. Обратитесь к администратору.";
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Обработчик сканера Cash должен сначала вызвать ЭтоДинамическийQR().
// Если Ложь — существующая обработка обычного штрихкода без изменений.
// Если Истина — ПолучитьШтрихкодКартыПоQR(); продолжать штатный сценарий только
// при Успех=Истина. Не создавать документы/движения в рамках проверки интеграции.
