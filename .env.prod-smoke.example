# ==============================================================================
# POSCENTER Loyalty Cloud - Production-like Smoke Environment Template
# ==============================================================================
# CAUTION: Do NOT commit real or fake secrets to version control.
# To generate a complete .env.prod-smoke file with cryptographically random keys:
#   python3 scripts/generate_prod_smoke_env.py
# ==============================================================================

# Core Application Settings
APP_ENV=production
DEBUG=false
APP_NAME=POSCENTER Loyalty
APP_VERSION=0.1.0
LOG_FORMAT=json
LOG_LEVEL=INFO

# External Exposed Port (via Reverse Proxy)
PORT=8080

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=poscenter_loyalty_smoke
POSTGRES_USER=poscenter_app
POSTGRES_PASSWORD=
DATABASE_URL=

# Database Connection Pool & Resilience Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=15000

# Cache & Rate Limiting (Redis 7)
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3

# JWT & Authentication Secrets (generate with scripts/generate_prod_smoke_env.py)
JWT_SIGNING_KEY=
ADMIN_JWT_SIGNING_KEY=
AUTH_CHALLENGE_HASH_KEY=
SMS_OTP_HASH_KEY=

# Admin Web SPA & Origin Security (JSON array format, HTTPS required in production)
ADMIN_ALLOWED_ORIGINS=["https://admin.loyalty.local","https://loyalty.local"]
ADMIN_ALLOW_INSECURE_HTTP=false
VITE_API_BASE_URL=https://loyalty.local
VITE_ALLOW_INSECURE_HTTP=0

# Trusted Reverse Proxy IP (single proxy container IP on isolated network)
FORWARDED_ALLOW_IPS=172.28.0.10

# SMS Provider Mode (real SMS adapter is NOT IMPLEMENTED; only 'disabled' is permitted)
SMS_PROVIDER_MODE=disabled

# WhatsApp & Wappi Integration Configuration
WHATSAPP_LOGIN_NUMBER=+77001234567
WAPPI_LOGIN_PROFILE_ID=smoke-profile-123
WAPPI_WEBHOOK_AUTH_HEADER=X-Wappi-Webhook-Signature
WAPPI_WEBHOOK_AUTH_SECRET=
